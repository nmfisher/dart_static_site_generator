{% if page.at_uri %}
<section id="comments-section" class="at-comments">
  <h2>Comments</h2>
  <div id="comments-container">
    <noscript>
      <p>Comments are loaded via JavaScript. <a href="https://bsky.app">View on Bluesky</a></p>
    </noscript>
    <div id="comments-loading">Loading comments...</div>
  </div>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  document.addEventListener('DOMContentLoaded', async function() {
    if (typeof AtCommentsWidget !== 'undefined') {
      window.atCommentsInstance = new AtCommentsWidget(
        'comments-container',
        '{{ page.at_uri }}',
        '{{ site.at_proto.app_view_url }}',
        '{{ site.at_proto.turnstile_site_key }}'
      );
      await window.atCommentsInstance.load();
    } else {
      console.error('AtCommentsWidget not loaded');
    }
  });
</script>
{% endif %}
