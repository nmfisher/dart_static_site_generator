<meta name="description" content="{{ page.seo.description | escape }}">
<link rel="canonical" href="{{ page.canonical_url | escape }}">
{% assign alternates = page.extras.alternates %}
{% if alternates %}
{% for pair in alternates %}<link rel="alternate" hreflang="{{ pair[0] }}" href="{{ pair[1] | absolute_url | escape }}">
{% endfor %}
{% for pair in alternates %}{% if pair[0] == site.i18n.default.code %}<link rel="alternate" hreflang="x-default" href="{{ pair[1] | absolute_url | escape }}">
{% endif %}{% endfor %}
{% endif %}
<meta property="og:title" content="{{ page.seo.title | escape }}">
<meta property="og:description" content="{{ page.seo.description | escape }}">
<meta property="og:url" content="{{ page.canonical_url | escape }}">
<meta property="og:type" content="{{ page.seo.type }}">
<meta name="twitter:card" content="{% if page.seo.image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ page.seo.title | escape }}">
<meta name="twitter:description" content="{{ page.seo.description | escape }}">
{% if page.seo.image %}<meta property="og:image" content="{{ page.seo.image | escape }}"><meta name="twitter:image" content="{{ page.seo.image | escape }}">{% endif %}
