<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}{{ page.title | default: 'Untitled Page' }}{% endblock %} - {{ site.title | default: 'My Website' }}</title>

    {% render '_includes/seo.liquid', page: page, site: site %}

    <link rel="stylesheet" href="/assets/style.css">
    <link rel="stylesheet" href="/assets/css/site.css">

    {% if site.rss.enabled %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.rss.title | default: site.title | default: 'RSS Feed' }}" href="/{{ site.rss.file_name | default: 'feed.xml' }}">
    {% endif %}

    {% if site.at_proto.enabled %}
    <link rel="stylesheet" href="/assets/css/at_comments.css">
    {% endif %}

    {% block head_extra %}{% endblock %}

</head>
<body>

    {% render '_includes/header.liquid', site: site, page: page %}

    <main class="container">
        {% block content %}
            <h1>{{ page.title | default: "Page Title Missing" }}</h1>
            {{ content }}
        {% endblock %}
    </main>

    {% render '_includes/footer.liquid', site: site, page: page %}

    {% if site.at_proto.enabled %}
    <script src="/assets/js/at_comments.js"></script>
    {% endif %}

    {% block scripts %}
    {% endblock %}

</body>
</html>
