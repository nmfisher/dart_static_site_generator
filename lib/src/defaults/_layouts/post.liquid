{% layout '_layouts/default.liquid' %}

{% block title %}{{ page.title | default: "Post Title Missing" }}{% endblock %}

{% block content %}
    <article class="post">
        <header class="post-header">
            <h1>{{ page.title | default: "Post Title Missing" }}</h1>
            {% if page.date %}
                <p class="post-meta">
                    <time datetime="{{ page.formatted_date }}">
                        {{ page.long_date }}
                    </time>
                </p>
            {% endif %}
        </header>

        {{ page.toc }}
        <div class="post-content">
            {{ content }}
        </div>

    </article>

    <nav class="post-navigation" aria-label="Post navigation">
    {% if page.previous %}<a rel="prev" href="{{ page.previous.route | relative_url }}">← {{ page.previous.title | escape }}</a>{% endif %}
    {% if page.next %}<a rel="next" href="{{ page.next.route | relative_url }}">{{ page.next.title | escape }} →</a>{% endif %}
    </nav>
    {% render '_includes/comments.liquid', site: site, page: page %}
{% endblock %}
