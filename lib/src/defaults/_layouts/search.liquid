{% layout '_layouts/default.liquid' %}
{% block content %}
<h1>Search</h1>
<form id="site-search" role="search" data-index="{{ page.search_index | default: '/search-index.json' | relative_url }}">
<label for="search-query">Search this site</label>
<input id="search-query" name="q" type="search" autocomplete="off">
<button type="submit">Search</button>
</form>
<p id="search-status" role="status" aria-live="polite"></p>
<ol id="search-results"></ol>
<script src="{{ '/assets/js/search.js' | relative_url }}" defer></script>
{% endblock %}
